{
  "manifest_version": 3,
  "name": "Faible",
  "version": "0.4.0",
  "description": "Records Higgsfield and Magnific generations into the studio's Faible provenance log, and collects Higgsfield history and usage pages (the integrated Higgsfield exporter).",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://*.higgsfield.ai/*",
    "https://*.magnific.com/*",
    "https://*.magnific.ai/*",
    "https://*.freepik.com/*",
    "https://d8j0ntlcm91z4.cloudfront.net/*",
    "https://d2ol7oe51mr4n9.cloudfront.net/*",
    "https://*.cdnpk.net/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Faible"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.higgsfield.ai/*",
        "https://*.magnific.com/*",
        "https://*.magnific.ai/*",
        "https://*.freepik.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.higgsfield.ai/*",
        "https://*.magnific.com/*",
        "https://*.magnific.ai/*",
        "https://*.freepik.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
